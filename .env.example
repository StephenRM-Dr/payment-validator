# Database (Neon Postgres or any Postgres-compatible connection string)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Webhook signature secret for the Binance Pay incoming webhook
WEBHOOK_SECRET=your-webhook-secret

# Google Gemini API key, used for receipt OCR
GEMINI_API_KEY=your-gemini-api-key

# Admin panel PIN
ADMIN_PIN=1234

# Telegram bot used for payment notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_CHAT_ID_VES=-1000000000001

# Signs the teller (cajero) session cookie/header
CAJERO_SECRET=your-cajero-secret

# BDV (Banco de Venezuela) business accounts used by the balance-inquiry API
BDV_CUENTA_1=00000000000000000001
BDV_CUENTA_2=00000000000000000002
BDV_API_KEY_1=your-bdv-api-key-1
BDV_API_KEY_2=your-bdv-api-key-2
BDV_TELEFONO_DESTINO_1=04140000001
BDV_TELEFONO_DESTINO_2=04140000002

# Bridge services for Sofitasa and Bancamiga (run outside Vercel)
SOFITASA_PUENTE_URL=https://example.com/sofitasa-bridge
BANCAMIGA_PUENTE_URL=https://example.com/bancamiga-bridge
PUENTE_SECRETO=your-bridge-secret
SOFITASA_PUENTE_SECRETO=your-sofitasa-bridge-secret
BANCAMIGA_PUENTE_SECRETO=your-bancamiga-bridge-secret
